# AWS Configuration (Optional - for server-side defaults)
AWS_REGION=us-east-1
AWS_DEFAULT_INSTANCE_TYPE=t2.micro
AWS_DEFAULT_AMI=ami-0c02fb55956c7d316

# Admin AWS Credentials (Required for creating temporary credentials)
AWS_ADMIN_ACCESS_KEY=your-admin-access-key-here
AWS_ADMIN_SECRET_KEY=your-admin-secret-key-here

# API Security
API_SECRET_KEY=your-strong-api-secret-key-here
NEXT_PUBLIC_API_SECRET_KEY=your-strong-api-secret-key-here

# Next.js Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here
